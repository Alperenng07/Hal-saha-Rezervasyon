generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  supabaseId    String         @unique
  email         String         @unique
  name          String?
  phone         String?
  role          Role           @default(USER)
  bookings      Booking[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BusinessSettings {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String?
  siteTitle  String
  phone      String?
  email      String?
  adminEmail              String?
  themeColor              String   @default("emerald")
  notifyEmailOnBooking    Boolean  @default(true)
  notifyWhatsAppOnBooking Boolean  @default(false)
  whatsappApiKey          String?
  createdAt               DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Pitch {
  id                  String         @id @default(uuid())
  name                String
  description         String?
  openTime            String
  closeTime           String
  slotDurationMinutes Int            @default(60)
  slotOffsetMinutes   Int            @default(0)
  bookings            Booking[]
  subscriptions       Subscription[]
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Booking {
  id        String        @id @default(uuid())
  pitchId   String
  pitch     Pitch         @relation(fields: [pitchId], references: [id])
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  guestName  String?
  guestPhone String?
  date      DateTime      @db.Date
  startTime String
  endTime   String
  status    BookingStatus @default(CONFIRMED)
  isManual  Boolean       @default(false)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([pitchId, date, startTime])
}

model Subscription {
  id         String    @id @default(uuid())
  pitchId    String
  pitch      Pitch     @relation(fields: [pitchId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  guestName  String?
  guestPhone String?
  dayOfWeek  Int
  startTime  String
  endTime    String
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  isActive   Boolean   @default(true)
  notes      String?
  exceptions SubscriptionException[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SubscriptionException {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, date])
}
